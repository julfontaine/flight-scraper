# ---- Database: pick ONE of the two blocks (DATABASE_URL wins when both are set). Leave both empty for --dry-run only.

# (a) Local PostgreSQL via docker compose (`just up`). Matches the defaults in docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/flights
#POSTGRES_PORT=5433
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#POSTGRES_DB=flights

# (b) Supabase project (server-side only; NEVER expose the service key to the website)
# SUPABASE_SERVICE_KEY is the new-style secret key ("sb_secret_...") — Project Settings > API keys.
# The website uses the "sb_publishable_..." key and only sees itineraries + latest_prices via RLS.
#SUPABASE_URL=https://<project-ref>.supabase.co
#SUPABASE_SERVICE_KEY=sb_secret_...

# Browser engine: playwright (default, live-verified) | patchright (optional stealth; pip install -e .[stealth])
FS_BROWSER_ENGINE=playwright
# 1 = show the browser window (needs a display or xvfb-run); 0 = headless (default)
FS_HEADED=0
# Override budget.max_page_loads_per_run from watchlist.yaml for one run (optional)
#FS_MAX_PAGE_LOADS=40
# DEBUG | INFO | WARNING
FS_LOG_LEVEL=INFO
